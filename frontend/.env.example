# ==============================================================================
# Jabour Phone Frontend - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values if needed. Never commit .env.

# ------------------------------------------------------------------------------
# API Base URL
# ------------------------------------------------------------------------------
# In local development:
#   Leave blank. The Vite dev server proxies "/api" to http://localhost:5000.
#
# In unified single-domain production (Express serving both API & frontend):
#   Leave blank. Frontend makes same-origin requests to "/api/...".
#
# In split-domain production (e.g. Vercel frontend + Railway/Render backend):
#   Set to your backend URL:
#   VITE_API_BASE_URL="https://api.jabourphone.com"
VITE_API_BASE_URL=""
