{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "index.js",
      "buildCommand": "prisma generate && tsc"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "path": "/api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "path": "/api/$1"
      }
    },
    {
      "source": "/health",
      "destination": {
        "path": "/health"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "path": "/health/$1"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "path": "/uploads/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "path": "/$1"
      }
    }
  ]
}