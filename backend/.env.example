# Copy this file to .env and fill in real values. Never commit .env.

# Express server port
PORT=5000

# PostgreSQL connection string used by Prisma (must match POSTGRES_PASSWORD below)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/electro_db?schema=public"

# Password for the PostgreSQL container; docker compose reads it from this .env file
POSTGRES_PASSWORD="YOUR_PASSWORD"

# Allowed frontend origin for CORS
FRONTEND_URL="http://localhost:5173"

# Secret used to sign admin auth tokens. Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Admin token/cookie lifetime in seconds (default 28800 = 8 hours)
JWT_EXPIRES_IN_SECONDS=28800
