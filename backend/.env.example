# ==============================================================================
# Jabour Phone Backend - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values. Never commit .env to git.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port for the Express server (default: 5000)
PORT=5000

# Environment mode: "development" | "production" | "test"
NODE_ENV=development

# Unified deployment: set to "true" to have Express serve the frontend static
# build from frontend/dist on the same port/domain (recommended for single-server setups)
SERVE_FRONTEND=false

# Optional custom path to frontend dist directory (defaults to ../frontend/dist)
# FRONTEND_DIST_PATH="../frontend/dist"

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
# For local Docker Compose, use POSTGRES_PASSWORD below.
# For cloud databases (Railway, Render, Supabase, Neon), add ?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/electro_db?schema=public"

# Password for the PostgreSQL container (used by backend/docker-compose.yml)
POSTGRES_PASSWORD="YOUR_PASSWORD"

# ------------------------------------------------------------------------------
# 3. Security, CORS & Authentication
# ------------------------------------------------------------------------------
# Allowed frontend origin for CORS (e.g. "https://jabourphone.com" in production)
FRONTEND_URL="http://localhost:5173"

# Optional additional allowed origins, comma-separated
# CORS_ORIGIN="https://admin.jabourphone.com,https://jabourphone.com"

# Secret key used to sign admin JWT cookies.
# MUST be a strong random string of at least 32 characters in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Admin JWT token/cookie lifetime in seconds (default: 28800 = 8 hours)
JWT_EXPIRES_IN_SECONDS=28800

# ------------------------------------------------------------------------------
# 4. Rate Limiting
# ------------------------------------------------------------------------------
# Login rate limiting: window in milliseconds and maximum attempts per IP
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_SKIP_SUCCESSFUL=true

# Public order submission rate limit (default: 10 orders per 15 minutes per IP)
ORDER_RATE_LIMIT_WINDOW_MS=900000
ORDER_RATE_LIMIT_MAX=10

# Newsletter submission rate limit (default: 5 signups per 15 minutes per IP)
NEWSLETTER_RATE_LIMIT_WINDOW_MS=900000
NEWSLETTER_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# 5. File Uploads & Asset Persistence
# ------------------------------------------------------------------------------
# Local persistent upload storage directory (defaults to ./uploads)
# In Docker or VPS, mount a persistent volume to this path.
UPLOADS_DIR="./uploads"

# Optional Cloudinary Configuration (for persistent cloud storage)
# If configured, product and category images upload directly to Cloudinary.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Or single connection URL:
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ------------------------------------------------------------------------------
# 6. Initial Production Seed Credentials (Optional)
# ------------------------------------------------------------------------------
# Used by `npm run prod:init` or `npm run prisma:seed` to create the initial admin
ADMIN_EMAIL="jabour@jabourphone.com"
ADMIN_PASSWORD="CHANGE_ME_INITIAL_STRONG_PASSWORD_123!"
ADMIN_NAME="Jabour"

# ------------------------------------------------------------------------------
# 7. Email Notifications (Optional SMTP)
# ------------------------------------------------------------------------------
# If omitted, order confirmations and alerts log safely to the console.
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@yourdomain.com"
# SMTP_PASS="your_smtp_password"
# EMAIL_FROM="Jabour Phone <orders@jabourphone.com>"
# ADMIN_NOTIFICATION_EMAIL="jabour@jabourphone.com"
