{
  "name": "jabour-phone-backend",
  "version": "1.0.0",
  "description": "Jabour Phone E-Commerce REST API powered by Express, Prisma, and PostgreSQL",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "lint": "tsc --noEmit",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:demo": "tsx prisma/demo-seed.ts",
    "prod:init": "prisma migrate deploy && tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "admin:reset": "tsx src/scripts/resetAdmin.ts",
    "db:backup": "tsx src/scripts/dbBackup.ts",
    "db:restore": "tsx src/scripts/dbRestore.ts",
    "test": "tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "prisma": "^6.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
