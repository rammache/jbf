{
  "name": "jabour-phone",
  "version": "1.0.0",
  "private": true,
  "description": "Jabour Phone E-Commerce Platform (React, Vite, Express, Prisma, PostgreSQL)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --prefix backend && npm run build --prefix frontend && node scripts/copyDist.js",
    "postinstall": "npm run prisma:generate --prefix backend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "prod:init": "npm run prod:init --prefix backend",
    "admin:create": "npm run admin:create --prefix backend",
    "admin:reset": "npm run admin:reset --prefix backend",
    "db:backup": "npm run db:backup --prefix backend",
    "db:restore": "npm run db:restore --prefix backend"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "prisma": "^6.4.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.19.6"
  }
}
